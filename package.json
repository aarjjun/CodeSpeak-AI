{
  "name": "codespeak-ai",
  "displayName": "CodeSpeak AI",
  "description": "The AI-powered accessibility assistant for developers.",
  "version": "0.2.0",
  "private": true,
  "publisher": "codespeak-ai",
  "license": "SEE LICENSE IN LICENSE.txt",
  "preview": true,
  "pricing": "Free",
  "icon": "resources/codespeak-icon.png",
  "galleryBanner": {
    "color": "#080b59",
    "theme": "dark"
  },
  "keywords": [
    "accessibility",
    "screen reader",
    "voice coding",
    "blind developers",
    "low vision",
    "motor accessibility",
    "dyslexia",
    "ADHD",
    "Gemini",
    "OpenAI",
    "code explanation",
    "WCAG",
    "AST"
  ],
  "engines": {
    "vscode": "^1.98.0"
  },
  "categories": [
    "Education",
    "Machine Learning",
    "Programming Languages",
    "Other"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "activationEvents": [
    "onStartupFinished",
    "onView:codespeak.dashboard"
  ],
  "contributes": {
    "commands": [
      {
        "command": "codespeak.setApiKey",
        "title": "Set Gemini API Key",
        "category": "CodeSpeak AI"
      },
      {
        "command": "codespeak.ai.toggleDemoMode",
        "title": "Enable or Disable Local Demo AI",
        "category": "CodeSpeak AI"
      },
      {
        "command": "codespeak.clearApiKey",
        "title": "Clear Gemini API Key",
        "category": "CodeSpeak AI"
      },
      {
        "command": "codespeak.setOpenAiApiKey",
        "title": "Set OpenAI API Key",
        "category": "CodeSpeak AI"
      },
      {
        "command": "codespeak.clearOpenAiApiKey",
        "title": "Clear OpenAI API Key",
        "category": "CodeSpeak AI"
      },
      {
        "command": "codespeak.openFile",
        "title": "Open Workspace File",
        "category": "CodeSpeak AI"
      },
      {
        "command": "codespeak.openFolder",
        "title": "Open Folder by Voice",
        "category": "CodeSpeak AI"
      },
      {
        "command": "codespeak.openRecentFolder",
        "title": "Open Recent Folder",
        "category": "CodeSpeak AI"
      },
      {
        "command": "codespeak.goToLine",
        "title": "Go to Line",
        "category": "CodeSpeak AI"
      },
      {
        "command": "codespeak.listDiagnostics",
        "title": "Navigate Workspace Diagnostics",
        "category": "CodeSpeak AI"
      },
      {
        "command": "codespeak.nextDiagnostic",
        "title": "Go to Next Diagnostic",
        "category": "CodeSpeak AI"
      },
      {
        "command": "codespeak.previousDiagnostic",
        "title": "Go to Previous Diagnostic",
        "category": "CodeSpeak AI"
      },
      {
        "command": "codespeak.undo",
        "title": "Undo",
        "category": "CodeSpeak AI"
      },
      {
        "command": "codespeak.redo",
        "title": "Redo",
        "category": "CodeSpeak AI"
      },
      {
        "command": "codespeak.generateCode",
        "title": "Generate Code",
        "category": "CodeSpeak AI"
      },
      {
        "command": "codespeak.explainSelection",
        "title": "Explain Selected Code",
        "category": "CodeSpeak AI"
      },
      {
        "command": "codespeak.askLearningQuestion",
        "title": "Ask a Learning Question",
        "category": "CodeSpeak AI"
      },
      {
        "command": "codespeak.explainDiagnostic",
        "title": "Explain Diagnostic",
        "category": "CodeSpeak AI"
      },
      {
        "command": "codespeak.generateDocumentation",
        "title": "Generate Documentation for Selection",
        "category": "CodeSpeak AI"
      },
      {
        "command": "codespeak.summarizeFile",
        "title": "Summarize Current File",
        "category": "CodeSpeak AI"
      },
      {
        "command": "codespeak.summarizeFolder",
        "title": "Summarize Current Folder",
        "category": "CodeSpeak AI"
      },
      {
        "command": "codespeak.summarizeWorkspace",
        "title": "Summarize Workspace",
        "category": "CodeSpeak AI"
      },
      {
        "command": "codespeak.selectAccessibilityProfile",
        "title": "Select Accessibility Profile",
        "category": "CodeSpeak AI"
      },
      {
        "command": "codespeak.accessibility.showControls",
        "title": "Show Accessible Controls",
        "category": "CodeSpeak AI"
      },
      {
        "command": "codespeak.readCodeStructure",
        "title": "Read Code Structure",
        "category": "CodeSpeak AI"
      },
      {
        "command": "codespeak.readSelectionContext",
        "title": "Read Selected Code with Context",
        "category": "CodeSpeak AI"
      },
      {
        "command": "codespeak.readSelectionDiagnostics",
        "title": "Find Errors in Selection",
        "category": "CodeSpeak AI"
      },
      {
        "command": "codespeak.explainCurrentFunction",
        "title": "Explain Current Function",
        "category": "CodeSpeak AI"
      },
      {
        "command": "codespeak.readCurrentLine",
        "title": "Read Current Line",
        "category": "CodeSpeak AI"
      },
      {
        "command": "codespeak.readCurrentDiagnostic",
        "title": "Read Current Diagnostic",
        "category": "CodeSpeak AI"
      },
      {
        "command": "codespeak.readAllDiagnostics",
        "title": "Read All Diagnostics",
        "category": "CodeSpeak AI"
      },
      {
        "command": "codespeak.readNextDiagnostic",
        "title": "Read Next Diagnostic",
        "category": "CodeSpeak AI"
      },
      {
        "command": "codespeak.readNextLine",
        "title": "Read Next Line",
        "category": "CodeSpeak AI"
      },
      {
        "command": "codespeak.readPreviousLine",
        "title": "Read Previous Line",
        "category": "CodeSpeak AI"
      },
      {
        "command": "codespeak.whereAmI",
        "title": "Where Am I",
        "category": "CodeSpeak AI"
      },
      {
        "command": "codespeak.copilot.ask",
        "title": "Ask GitHub Copilot Chat",
        "category": "CodeSpeak AI"
      },
      {
        "command": "codespeak.voice.listCommands",
        "title": "List Voice Commands",
        "category": "CodeSpeak AI"
      },
      {
        "command": "codespeak.voice.nextCommands",
        "title": "Read Next Voice Command Group",
        "category": "CodeSpeak AI"
      },
      {
        "command": "codespeak.checkAccessibility",
        "title": "Check Current File Accessibility",
        "category": "CodeSpeak AI"
      },
      {
        "command": "codespeak.clearAccessibilityFindings",
        "title": "Clear Accessibility Findings",
        "category": "CodeSpeak AI"
      },
      {
        "command": "codespeak.voice.toggle",
        "title": "Start or Stop Voice Command",
        "category": "CodeSpeak AI",
        "enablement": "!codespeak.voiceProcessing"
      },
      {
        "command": "codespeak.voice.startContinuous",
        "title": "Start Continuous Voice Mode",
        "category": "CodeSpeak AI",
        "enablement": "!codespeak.voiceListening"
      },
      {
        "command": "codespeak.voice.stopContinuous",
        "title": "Stop Continuous Voice Mode",
        "category": "CodeSpeak AI",
        "enablement": "codespeak.voiceListening"
      },
      {
        "command": "codespeak.voice.simulate",
        "title": "Enter Voice Command as Text",
        "category": "CodeSpeak AI"
      },
      {
        "command": "codespeak.speech.speakSelection",
        "title": "Read Selection Aloud",
        "category": "CodeSpeak AI"
      },
      {
        "command": "codespeak.speech.stop",
        "title": "Stop Reading Aloud",
        "category": "CodeSpeak AI"
      },
      {
        "command": "codespeak.speech.pause",
        "title": "Pause Reading Aloud",
        "category": "CodeSpeak AI"
      },
      {
        "command": "codespeak.speech.resume",
        "title": "Resume Reading Aloud",
        "category": "CodeSpeak AI"
      },
      {
        "command": "codespeak.speech.repeat",
        "title": "Repeat Last Spoken Message",
        "category": "CodeSpeak AI"
      },
      {
        "command": "codespeak.speech.slower",
        "title": "Speak Slower",
        "category": "CodeSpeak AI"
      },
      {
        "command": "codespeak.speech.faster",
        "title": "Speak Faster",
        "category": "CodeSpeak AI"
      },
      {
        "command": "codespeak.focus.startTimer",
        "title": "Start Focus Timer",
        "category": "CodeSpeak AI"
      },
      {
        "command": "codespeak.focus.pauseTimer",
        "title": "Pause Focus Timer",
        "category": "CodeSpeak AI"
      },
      {
        "command": "codespeak.focus.resetTimer",
        "title": "Reset Focus Timer",
        "category": "CodeSpeak AI"
      },
      {
        "command": "codespeak.focus.toggleView",
        "title": "Toggle Focus View",
        "category": "CodeSpeak AI"
      }
    ],
    "keybindings": [
      {
        "command": "codespeak.voice.toggle",
        "key": "ctrl+alt+space",
        "mac": "cmd+alt+space",
        "when": "editorTextFocus && !codespeak.voiceListening"
      },
      {
        "command": "codespeak.voice.toggle",
        "key": "ctrl+alt+space",
        "mac": "cmd+alt+space",
        "when": "codespeak.voiceListening"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "codespeak.dashboard",
          "name": "CodeSpeak AI",
          "when": "true"
        }
      ]
    },
    "configuration": {
      "title": "CodeSpeak AI",
      "properties": {
        "codespeak.model": {
          "type": "string",
          "default": "gemini-3.5-flash",
          "description": "Gemini model used only by the optional fallback provider."
        },
        "codespeak.openaiModel": {
          "type": "string",
          "default": "gpt-5.6-sol",
          "description": "OpenAI model used for primary AI requests."
        },
        "codespeak.ai.demoMode": {
          "type": "boolean",
          "default": false,
          "description": "Use deterministic local demo responses without contacting OpenAI or Gemini. Demo responses are clearly identified and are not semantic AI analysis."
        },
        "codespeak.voice.language": {
          "type": "string",
          "default": "en-US",
          "description": "BCP 47 language tag used for speech output. Voice input follows the VS Code Speech language setting."
        },
        "codespeak.voice.rate": {
          "type": "number",
          "default": 1,
          "minimum": 0.5,
          "maximum": 2,
          "description": "Speech synthesis rate."
        },
        "codespeak.voice.volume": {
          "type": "number",
          "default": 100,
          "minimum": 0,
          "maximum": 100,
          "description": "Speech output volume from zero to one hundred."
        },
        "codespeak.voice.name": {
          "type": "string",
          "default": "",
          "description": "Optional operating-system speech voice name."
        },
        "codespeak.voice.activationMode": {
          "type": "string",
          "enum": [
            "toggle",
            "continuous"
          ],
          "enumDescriptions": [
            "One shortcut press starts listening and another stops it.",
            "Listening restarts after every processed utterance until explicitly stopped."
          ],
          "default": "toggle",
          "description": "Default voice listening mode."
        },
        "codespeak.voice.silenceTimeoutSeconds": {
          "type": "number",
          "default": 1.5,
          "minimum": 0.5,
          "maximum": 10,
          "description": "Seconds of silence after recognized speech before the current utterance is processed."
        },
        "codespeak.voice.initialSpeechTimeoutSeconds": {
          "type": "number",
          "default": 12,
          "minimum": 5,
          "maximum": 60,
          "description": "Seconds to wait for the first recognized speech before stopping the listening session."
        },
        "codespeak.voice.continuousListening": {
          "type": "boolean",
          "default": false,
          "description": "Restart voice listening after each processed utterance."
        },
        "codespeak.voice.confirmBeforeDestructiveActions": {
          "type": "boolean",
          "default": true,
          "description": "Require spoken confirmation before potentially destructive voice actions."
        },
        "codespeak.voice.audioCues": {
          "type": "boolean",
          "default": true,
          "description": "Play optional non-verbal audio cues for voice state and command results."
        },
        "codespeak.blindMode.confirmWorkspaceChanges": {
          "type": "boolean",
          "default": true,
          "description": "Confirm before a voice command changes the current workspace."
        },
        "codespeak.privacy.includeSelectionInAiRequests": {
          "type": "boolean",
          "default": true,
          "description": "Allow explicitly requested AI and Copilot actions to include selected code."
        },
        "codespeak.privacy.storeVoiceTranscripts": {
          "type": "boolean",
          "default": false,
          "description": "Reserved privacy control. CodeSpeak does not store transcripts in this release."
        },
        "codespeak.accessibilityProfile": {
          "type": "string",
          "enum": [
            "blind",
            "low-vision",
            "dyslexia",
            "motor",
            "adhd",
            "custom"
          ],
          "enumDescriptions": [
            "Screen-reader-centered interaction and concise structural narration.",
            "High-clarity visual presentation with optional spoken support.",
            "Reduced reading complexity and structured explanations.",
            "Reduced interaction precision and stronger confirmation support.",
            "Reduced distraction and shorter, grouped information.",
            "User-defined accessibility behavior."
          ],
          "default": "custom",
          "description": "Default accessibility behavior profile. Visual presets are applied to workspace settings and restored when Custom Mode is selected."
        },
        "codespeak.focus.minutes": {
          "type": "number",
          "minimum": 1,
          "maximum": 120,
          "default": 25,
          "description": "Length of an ADHD Mode focus session in minutes."
        },
        "codespeak.focus.breakMinutes": {
          "type": "number",
          "minimum": 1,
          "maximum": 120,
          "default": 5,
          "description": "Length of the break reminder countdown after a focus session."
        },
        "codespeak.autoExplainErrors": {
          "type": "boolean",
          "default": false,
          "description": "Offer accessible explanations when new diagnostics appear."
        },
        "codespeak.autoReadSummaries": {
          "type": "boolean",
          "default": false,
          "description": "Read generated summaries aloud when speech is enabled."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "npm run check-types && tsc -p tsconfig.build.json",
    "watch": "tsc -p tsconfig.build.json --watch",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:integration:compile": "npm run build && tsc -p tsconfig.integration.json",
    "test:integration": "npm run test:integration:compile && node scripts/run-integration-tests.mjs",
    "test:all": "npm run test && npm run test:integration",
    "test:coverage": "node scripts/run-coverage.mjs",
    "verify": "npm audit --audit-level=high && npm run check-types && npm run lint && npm run format:check && npm run test:coverage",
    "package": "vsce package --allow-missing-repository",
    "release:check": "npm run verify && npm run test:integration && npm run package"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.1",
    "@types/vscode": "1.98.0",
    "@vitest/coverage-v8": "4.1.10",
    "@vscode/test-electron": "3.0.0",
    "@vscode/vsce": "3.9.2",
    "eslint": "10.7.0",
    "prettier": "3.9.5",
    "typescript-eslint": "8.64.0",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "typescript": "^5.9.3"
  }
}
